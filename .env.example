NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Read by src/lib/supabase/admin.ts for auth.admin calls and for
# claim_pending_emails(); never by application code that runs under RLS.
SUPABASE_SECRET_KEY=

# ── Email ─────────────────────────────────────────────────────────────────
# Resend, over HTTPS. Outbound SMTP does not survive this network, and 443
# works wherever the browser does.
#
# Server-only. Never rename this to NEXT_PUBLIC_ — that would ship a
# send-as-you key to every browser that loads the app.
RESEND_API_KEY=

# Until MMCY's domain is verified in Resend, the only address it will send
# from is onboarding@resend.dev, and the only address it will deliver to is
# the Resend account owner's. Production needs that domain verified first.
EMAIL_FROM=IMS Portal <onboarding@resend.dev>

# Outside production every email goes here instead of to the address on the
# notification row. The test accounts are @ex.com — a real domain belonging to
# someone else — so without this nothing is sent at all. That is deliberate:
# refusing to send is safer than silently mailing strangers.
EMAIL_REDIRECT_TO=

# Base for the link in an email. Keep it localhost in development: a LAN
# address ends up in an inbox and stops resolving the moment you change
# network.
APP_URL=http://localhost:3000
