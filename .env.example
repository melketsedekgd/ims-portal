NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Read by src/lib/supabase/admin.ts for auth.admin calls and for
# claim_pending_emails(); never by application code that runs under RLS.
SUPABASE_SECRET_KEY=

# ── Email ─────────────────────────────────────────────────────────────────
# SMTP so the transport is configuration, not code: Gmail in development,
# MMCY's mail server later, with only these values changing.
# For Gmail, SMTP_PASS is a 16-character app password, not the account
# password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Outside production every email goes here instead of to the address on the
# notification row. The test accounts are @ex.com — a real domain belonging to
# someone else — so without this nothing is sent at all. That is deliberate:
# refusing to send is safer than silently mailing strangers.
EMAIL_REDIRECT_TO=

# Base for the link in an email. Keep it localhost in development: a LAN
# address ends up in an inbox and stops resolving the moment you change
# network.
APP_URL=http://localhost:3000
